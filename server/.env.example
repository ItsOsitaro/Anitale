ADMIN_USER=admin
# Generate with: npm run hash-password -- yourPassword   (or just run: npm run setup-admin)
ADMIN_PASSWORD_HASH='$2b$12$replace-me'
# For scripts/smoke.mjs — pass these explicitly on the command line (the
# plaintext password lives ONLY in these vars, never on disk in this file).
# SMOKE_ADMIN_USER=<admin username>        (same value as ADMIN_USER)
# SMOKE_ADMIN_PASS=<plaintext password>    (NOT stored anywhere on disk)
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
# Optional proxy for Jikan + MyAnimeList images (VPN users), e.g. http://127.0.0.1:10809
PROXY_URL=
# Provider tuning for imports/searches:
#   PROVIDER=anilist      skip Jikan entirely (fast path; AniList is the data source)
#   JIKAN_DISABLED=1      same effect, triggered via the Jikan circuit breaker path
#   JIKAN_TIMEOUT_MS=7000 connection timeout per Jikan call (ms)
# Jikan is also auto-skipped (with backoff) once it has failed on the network.
# PROVIDER=
# JIKAN_DISABLED=
# JIKAN_TIMEOUT_MS=
# Optional, for testing against a local mock: JIKAN_BASE_URL=http://127.0.0.1:4010/v4
# Gemini API key (https://aistudio.google.com/apikey) — best Persian; first in the chain when set. Pin with TRANSLATE_PROVIDER=gemini or pick it from the admin Settings page.
# GEMINI_API_KEY=
