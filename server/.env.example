ADMIN_USER=admin
# Generate with: npm run hash-password -- yourPassword   (or just run: npm run setup-admin)
ADMIN_PASSWORD_HASH='$2b$12$replace-me'
# For scripts/smoke.mjs — pass these explicitly on the command line (the
# plaintext password lives ONLY in these vars, never on disk in this file).
# SMOKE_ADMIN_USER=<admin username>        (same value as ADMIN_USER)
# SMOKE_ADMIN_PASS=<plaintext password>    (NOT stored anywhere on disk)
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
# Optional local proxy (Xray/v2ray) used ONLY by the site for Tenrai, AniList, cover downloads and translation.
# Create its config with: node server/scripts/make-xray-config.js "<your vless/vmess/trojan link>"
# Example: PROXY_URL=http://127.0.0.1:10809   (keep it on its own line)
PROXY_URL=
# Provider tuning for imports/searches:
#   PROVIDER=anilist        skip Tenrai entirely (AniList becomes the only data source)
#   TENRAI_DISABLED=1       same effect, triggered via the Tenrai circuit breaker path
#   TENRAI_TIMEOUT_MS=7000  timeout per Tenrai call (ms; 25000 when a proxy/VPN is on)
#   TENRAI_SERVER_KEY=      optional X-Server-Key (higher rate limit; keep it server-side)
# Tenrai (api.tenrai.org) is the primary source; AniList is the fallback. Tenrai is also auto-skipped
# (with backoff) once it has failed on the network or answered 401/403/5xx.
# PROVIDER=
# TENRAI_DISABLED=
# TENRAI_TIMEOUT_MS=
# TENRAI_SERVER_KEY=
# Optional, for testing against a local mock: TENRAI_BASE_URL=http://127.0.0.1:4010/v1
# Gemini API key (https://aistudio.google.com/apikey) — best Persian; first in the chain when set. Pin with TRANSLATE_PROVIDER=gemini or pick it from the admin Settings page.
# GEMINI_API_KEY=

# --- Email (verification + password reset) ---
# Public address of the site; used for links inside emails.
SITE_URL=https://example.com
# Any SMTP provider. If SMTP_HOST is empty, emails are only printed to the server log.
SMTP_HOST=
SMTP_PORT=587
# 1 = implicit TLS (normally for port 465)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Anitale <no-reply@example.com>"

# Messenger bots for "new episode" alerts (optional; the account page shows a messenger only when its token is set).
# Create the bot with @BotFather (Telegram) or @botfather (Bale), then put the token and the bot's username here.
# Telegram is usually blocked from Iran: the server reaches it through PROXY_URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
