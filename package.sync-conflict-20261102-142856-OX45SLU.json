{
  "name": "anitale",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "export:data": "node server/export-data.js",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "start": "concurrently -k -n api,web -c cyan,magenta \"npm run server:watch\" \"npm run dev\"",
    "serve": "npm run build && node server/index.js",
    "seed": "node server/seed.js",
    "setup-admin": "node server/scripts/setup-admin.js",
    "setup:model": "node scripts/fetch-model.mjs",
    "hash-password": "node server/scripts/hash-password.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.2",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "core-js": "3.50.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "lodash": "4.18.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "multer": "^2.4.0",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.4",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "gh-pages": "^6.3.0",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.13"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true
